# ==============================================================================
# Stock Simulator - Production Environment Variables
# Architecture: Vercel Frontend + Oracle Cloud Backend
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERCEL FRONTEND CONFIGURATION
# Set these in the Vercel Project Settings -> Environment Variables:
# ------------------------------------------------------------------------------
# Public REST API URL pointing to the Oracle backend gateway (must end with /api/v1)
NEXT_PUBLIC_API_URL=https://api.<your-oracle-domain>.com/api/v1

# Public WebSocket URL pointing to the Oracle backend gateway (must end with /ws/market)
# (Optional: if omitted, the frontend automatically derives wss:// from NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_WS_URL=wss://api.<your-oracle-domain>.com/ws/market


# ------------------------------------------------------------------------------
# 2. ORACLE BACKEND STACK CONFIGURATION
# Set these on the Oracle host (e.g., in /home/ubuntu/Stock-Simulator/.env or backend/.env)
# ------------------------------------------------------------------------------
# Application Environment (enforces strict security checks, rejects wildcard CORS)
APP_ENV=production

# Server Port (default 8080)
PORT=8080

# Authoritative Allowed Origins for CORS & WebSockets (comma-separated if multiple)
# Must match your deployed Vercel frontend domain placeholder:
CORS_ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app

# PostgreSQL Database Connection URL (e.g. Neon PostgreSQL or OCI Managed PostgreSQL)
DATABASE_URL=postgres://user:password@<db-host>:5432/stock_simulator?sslmode=require

# High-entropy JWT Signing Secret (generate with: openssl rand -hex 32)
JWT_SECRET=<generate-secure-random-32-byte-hex-string>

# Redis Cache & PubSub bus (internal Docker service default)
REDIS_URL=redis://redis:6379/0

# Market Worker On-Demand Quote URL (internal Docker service default)
MARKET_WORKER_URL=http://market-worker:8085

# Angel One Institutional SmartAPI Credentials (for live NSE/BSE feeds)
# If omitted or disconnected, the Feed Supervisor automatically switches to 24/7 Synthetic simulation
ANGEL_API_KEY=<your-angel-api-key>
ANGEL_CLIENT_CODE=<your-angel-client-code>
ANGEL_PASSWORD=<your-angel-password>
ANGEL_TOTP_KEY=<your-angel-totp-key>
