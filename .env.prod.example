# ==============================================================================
# Stock Simulator - Production Environment Variables
# Architecture: Vercel Frontend + Oracle Cloud Backend
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERCEL FRONTEND CONFIGURATION
# Set these in the Vercel Project Settings -> Environment Variables:
# ------------------------------------------------------------------------------
# Public REST API URL pointing to the Oracle backend gateway (must end with /api/v1)
NEXT_PUBLIC_API_URL=https://api.<your-oracle-domain>.com/api/v1

# Public WebSocket URL pointing to the Oracle backend gateway (must end with /ws/market)
# (Optional: if omitted, the frontend automatically derives wss:// from NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_WS_URL=wss://api.<your-oracle-domain>.com/ws/market
# Server-only Vercel variables (NEVER prefix secrets with NEXT_PUBLIC_).
BACKEND_API_URL=https://api.example.com/api/v1
BACKEND_PROXY_SECRET=<same-random-secret-as-FRONTEND_PROXY_SECRET>
# Enable field Web Vitals collection on Vercel after deployment.
NEXT_PUBLIC_ENABLE_SPEED_INSIGHTS=true


# ------------------------------------------------------------------------------
# 2. ORACLE BACKEND STACK CONFIGURATION
# Copy this file to the repository-root .env on Oracle; keep secrets out of Git.
# Compose interpolation and all application containers use this same file.
# ------------------------------------------------------------------------------
# DNS-only API hostname pointing to the Oracle VM (no https:// or URL path)
API_DOMAIN=api.example.com
# Contact used by Caddy for automated HTTPS certificates
ACME_EMAIL=you@example.com
# Fixed gateway address and dedicated bridge. Change all three values together if overlapping.
# Compose derives Go's TRUSTED_PROXIES from CADDY_INTERNAL_IP automatically.
CADDY_INTERNAL_IP=172.30.250.2
GATEWAY_SUBNET=172.30.250.0/29
# Dynamic backend/one-off addresses exclude the fixed Caddy IP.
GATEWAY_DYNAMIC_RANGE=172.30.250.4/30

# Application Environment (enforces strict security checks, rejects wildcard CORS)
APP_ENV=production

# Internal port is fixed to 8080 by production Compose; it is not published.
PORT=8080

# Authoritative Allowed Origins for CORS & WebSockets (comma-separated if multiple)
# Must match your deployed Vercel frontend domain placeholder:
CORS_ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app

# PostgreSQL Database Connection URL (e.g. Neon PostgreSQL or OCI Managed PostgreSQL)
DATABASE_URL=postgres://user:password@<db-host>:5432/stock_simulator?sslmode=require

# High-entropy JWT Signing Secret (generate with: openssl rand -hex 32)
JWT_SECRET=<generate-secure-random-32-byte-hex-string>
# Separate shared secret for trustworthy frontend client-IP rate limiting.
FRONTEND_PROXY_SECRET=<generate-a-different-random-secret-with-openssl-rand-hex-32>

# Redis Cache & PubSub bus: production Compose uses this private service.
# A managed Redis migration needs an explicit Compose/dependency change.
REDIS_URL=redis://redis:6379/0

# Market Worker On-Demand Quote URL (internal Docker service default)
MARKET_WORKER_URL=http://market-worker:8085

# ------------------------------------------------------------------------------
# 3. MARKET FEED & EXECUTION SAFETY CONFIGURATION
# ------------------------------------------------------------------------------
# Market Feed Mode: 'live', 'synthetic', or 'disabled'
# In LIVE mode, real Angel One market data is required. If disconnected or missing,
# the system strictly fails closed (UNAVAILABLE) and orders are blocked to prevent bad fills.
MARKET_FEED_MODE=live

# Execution Safety: strictly disable seeded/synthetic quote execution in production
ALLOW_SEEDED_QUOTES=false
SIMULATION_MODE=false
ALLOW_SEEDED_EXECUTABLE_QUOTES=false

# Angel One SmartAPI Credentials (for LIVE feed mode)
# If credentials are not provided or feed is disconnected in LIVE mode,
# feed state becomes UNAVAILABLE and live trading halts (no silent synthetic fallback).
ANGEL_API_KEY=<your-angel-api-key>
ANGEL_CLIENT_ID=<your-angel-client-id>
ANGEL_PASSWORD=<your-angel-password>
ANGEL_TOTP_SECRET=<your-angel-totp-secret>

# No hidden host proxy default. Blank means direct Oracle broker egress.
# Existing host bridge: explicitly use http://host.docker.internal:8118 in BOTH variables.
# Optional Compose profile: use http://broker-proxy:8118, start --profile broker-proxy.
# Verify broker access from the selected egress; a proxy on the same VM does not change its public IP.
BROKER_HTTP_PROXY=
BROKER_HTTPS_PROXY=
