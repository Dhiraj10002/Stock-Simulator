APP_NAME=Stock Simulator
APP_ENV=development
PORT=8080
API_VERSION=v1
# Database: Use Neon PostgreSQL (DEV on laptop, PROD on Oracle VM)
# Example Neon connection: postgresql://<user>:<password>@ep-xyz.us-east-2.aws.neon.tech/stock_simulator?sslmode=require
# For local offline fallback (via `docker compose --profile local up`):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/stock_simulator?sslmode=disable
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/stock_simulator?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
INITIAL_VIRTUAL_BALANCE_PAISE=100000000

# Simulator-only product rules; these are not broker/exchange leverage rules.
MIS_LEVERAGE=5
FUTURES_MARGIN_PERCENT=20
OPTION_SELL_MARGIN_PERCENT=30

# Redis: Use Upstash Redis (DEV on laptop, PROD on Oracle VM)
# Upstash requires rediss:// with TLS:
# REDIS_URL=rediss://default:<token>@<upstash-host>.upstash.io:6379
# For local offline fallback (via `docker compose --profile local up`):
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=rediss://default:<token>@<upstash-host>.upstash.io:6379
REDIS_OPERATION_TIMEOUT=2s
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Used only by python-services/market-worker. Keep real values in backend/.env
# (or deployment environment variables), never in this file or source control.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
# Reconnect the SmartAPI feed if it remains open without a tick this long.
MARKET_FEED_STALE_SECONDS=120
