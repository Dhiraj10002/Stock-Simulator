APP_NAME=Stock Simulator
APP_ENV=development
PORT=8080
API_VERSION=v1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stock_simulator?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
INITIAL_VIRTUAL_BALANCE_PAISE=100000000
REDIS_URL=redis://localhost:6379/0
# Use rediss://:password@host:port for Upstash TCP Redis (TLS required).
REDIS_OPERATION_TIMEOUT=2s
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
